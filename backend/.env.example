# Copy to backend/.env — everything here is OPTIONAL.

# The real-data pipeline works with NO keys and NO accounts. ACS socioeconomic
# data is read from the Census Bureau's public Summary File bulk downloads.
#
# Setting a free Census API key (https://api.census.gov/data/key_signup.html)
# switches step 2 to the ACS API instead: smaller download, more vintages.
# Leave blank to use the keyless bulk loader.
CENSUS_API_KEY=

# Which dataset the API serves: demo | real
# Default: real if data/real/real_dataset.csv exists, otherwise demo.
# SPORTS_LAB_SOURCE=demo
